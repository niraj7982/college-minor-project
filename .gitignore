# Environments
venv/
.venv/
env/
.env/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Django stuff:
*.log
local_settings.py
# NOTE: db.sqlite3 is intentionally NOT ignored so Vercel can bundle it.
# The app copies it to /tmp at runtime since the project dir is read-only on Vercel.
db.sqlite3-journal

# VS Code / IDEs
.vscode/
.idea/
*.swp

# Environment variables
.env

# Migration files (optional: keep migrations but ignore local state if any)
# */migrations/*.py
# !*/migrations/__init__.py

# .vercel project config (local only)
# NOTE: staticfiles/ is intentionally NOT ignored — Vercel needs these to serve CSS/JS via WhiteNoise.
.vercel

.env*.local
